{
  "name": "cybbig",
  "productName": "Cybbig",
  "version": "0.4.0",
  "private": true,
  "description": "Poste local de cybersécurité défensive : veille, analyses PHP/Web/API, intégrité checkout, laboratoire et rapports.",
  "author": "Cybbig",
  "license": "UNLICENSED",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "npm --prefix frontend run build",
    "backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backend.ps1",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "install-app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22"
  }
}
